#!/bin/bash

BINARY_PATH="/root/setup"
CHECK_HOST="8.8.8.8"   # or any host you prefer
INTERVAL=3

run_binary() {
    echo "[monitor] starting binary..."
    "$BINARY_PATH"
    systemctl restart reverse-ssh.service
    # BIN_PID=$!
}

check_connection() {
    ping -c1 -W1 "$CHECK_HOST" >/dev/null 2>&1
    return $?
}

run_binary
# wait "$BIN_PID" 2>/dev/null

sleep 10

while true; do
    sleep "$INTERVAL"

    if ! check_connection; then
        echo "[monitor] connection lost — restarting binary..."

        run_binary

	sleep 10
    fi
done

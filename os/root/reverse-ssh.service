[Unit]
Description=Reverse SSH Tunnel
After=network-online.target
Wants=network-online.target

[Service]
User=root
ExecStart=/usr/bin/ssh -o "ServerAliveInterval 5" -o "ServerAliveCountMax 2" -N -R 0.0.0.0:2222:localhost:22 rc-tunnel@server -p 128           
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
